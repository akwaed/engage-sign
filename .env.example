# GoDaddy injects these five values automatically when Hosted Database is attached.
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Add these in GoDaddy Settings > Secrets for both Preview and Publish.
# Generate each with: openssl rand -base64 48
SETUP_TOKEN=
IP_HASH_SECRET=

# Absolute persistent directory outside the public web root.
# Required before templates or signed documents are stored/exported.
PRIVATE_STORAGE_PATH=

# Absolute path to the LibreOffice soffice executable for DOCX previews/test PDFs.
LIBREOFFICE_BIN=

# Used when links are created for email. Do not include a trailing slash.
APP_URL=https://sign.engagess.co

# Outlook SMTP — leave blank until the mail phase is implemented.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_REPLY_TO=

