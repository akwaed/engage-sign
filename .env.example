# Configure explicitly for the VPS; use separate development credentials locally.
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Store production values in protected /etc/engage-sign-vps/app.env, outside Git.
# Generate each with: openssl rand -base64 48
SETUP_TOKEN=
IP_HASH_SECRET=

# Generate with: openssl rand -base64 32 (exactly 32 random bytes).
# Required for AES-256-GCM encryption of signer identities, values, and evidence.
ENCRYPTION_KEY_V1=

# Absolute persistent directory outside the public web root.
# Required before templates or signed documents are stored/exported.
PRIVATE_STORAGE_PATH=

# Absolute path to the LibreOffice soffice executable for DOCX previews/test PDFs.
LIBREOFFICE_BIN=

# Used when links are created for email. Do not include a trailing slash.
APP_URL=https://sign.engagess.co

# Outlook SMTP, required before any document can be sent in production.
# Leave MAIL_TRANSPORT unset (or set smtp) on https://sign.engagess.co.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_REPLY_TO=

# HMAC key for new audit events. Use a long random secret. Existing sha256 events still verify.
# AUDIT_HMAC_KEY=

# Encrypt new template and final PDFs at rest. Base64 of 32 bytes. Unset keeps new files plaintext.
# Reading still accepts older unencrypted files. Encrypt existing files only with:
# node --import tsx scripts/vps/encrypt-private-files.ts --confirm
# FILE_ENCRYPTION_KEY_V1=

# Staff idle timeout in minutes. Default 30. Absolute session life stays 12 hours.
# SESSION_IDLE_MINUTES=30

# Number of trusted reverse proxies in front of Node. 1 matches this VPS nginx.
# Unset or 0 ignores X-Forwarded-For and uses X-Real-IP, then the socket address.
# TRUSTED_PROXY=1

# Include the document title in signing emails. Off by default so titles cannot reveal health context.
# MAIL_INCLUDE_DOCUMENT_TITLE=true

# Opt-in Kentucky TB-4 template seed. Never used by startup or the jobs timer.
# Refuses APP_URL=https://sign.engagess.co. Outside production, run: npm run seed:tb -- --confirm
# ENGAGE_ALLOW_TB_SEED=true

# Staging only. Writes messages to disk instead of SMTP. Off unless set to file.
# Refuses to start for APP_URL=https://sign.engagess.co.
# When NODE_ENV=production, also set ENGAGE_ALLOW_FILE_MAIL=true.
# MAIL_TRANSPORT=file
# MAIL_FILE_DIR=
# ENGAGE_ALLOW_FILE_MAIL=

